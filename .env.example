# Local dev Postgres (see docker-compose.yml) — port 5437 to avoid clashing
# with other projects' local Postgres containers (l-corner-manage: 5435, roihin: 5436)
DB_HOST=localhost
DB_PORT=5437
DB_DATABASE=tangpainai
DB_USERNAME=postgres
DB_PASSWORD=postgres

# LINE Messaging API channel (developers.line.biz > tangpainai provider > Messaging API channel)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Claude API (console.anthropic.com) — used for slip OCR + text categorization
ANTHROPIC_API_KEY=

# LINE MINI App channel (developers.line.biz > tangpainai provider > MINI App channel)
# Channel ID verifies the LIFF idToken server-side; LIFF ID is used client-side by liff.init()
LINE_MINIAPP_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=
